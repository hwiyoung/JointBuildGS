{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jointbuildgs.p2_c1_c2_feasibility_result.v1",
  "title": "P2 C1/C2 development feasibility building-condition row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "building_id", "group_id", "split", "method_id", "run_id", "operation_id",
    "criterion_version", "reference_provenance", "component_id", "operation_unit_id", "G0_generated",
    "G1_schema_semantic", "G1_check_class", "G2_internal_screen", "G2_check_class",
    "G2_geometry_topology_valid", "G2_null_reason", "G3_roof_structure_acceptable",
    "G4_geometric_accuracy_acceptable", "PASS_usable", "threshold_null_reason",
    "attempt_count", "retry_count", "runtime_seconds", "peak_memory_bytes",
    "input_point_count", "roofer_input_point_count", "output_bytes", "failure_reasons",
    "metrics", "scientific_verdict"
  ],
  "properties": {
    "building_id": {"type": "string", "pattern": "^DEBY_LOD2_[0-9]+$"},
    "group_id": {"type": "string", "pattern": "^GROUP_[0-9a-f]{16}$"},
    "split": {"const": "development"},
    "method_id": {"enum": ["C1_L_upper", "C2_MVS"]},
    "run_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criterion_version": {"const": "C1C5_CANON_v2_PROVISIONAL_P2_FEASIBILITY"},
    "reference_provenance": {"enum": ["SELF_REFERENCE_UPPER_BASELINE", "INDEPENDENT_UAS_SCORE_ONLY"]},
    "component_id": {"type": ["string", "null"]},
    "operation_unit_id": {"type": ["string", "null"]},
    "G0_generated": {"type": "boolean"},
    "G1_schema_semantic": {"type": ["boolean", "null"]},
    "G1_check_class": {"const": "PROVISIONAL_TECHNICAL_INTERNAL_SCHEMA_SEMANTIC"},
    "G2_internal_screen": {"type": ["boolean", "null"]},
    "G2_check_class": {"const": "DIAGNOSTIC_INTERNAL_NOT_CANONICAL_VAL3DITY"},
    "G2_geometry_topology_valid": {"type": "null"},
    "G2_null_reason": {"const": "CANONICAL_VALIDATOR_UNAVAILABLE"},
    "G3_roof_structure_acceptable": {"type": "null"},
    "G4_geometric_accuracy_acceptable": {"type": "null"},
    "PASS_usable": {"type": "null"},
    "threshold_null_reason": {"const": "THRESHOLD_NOT_FROZEN"},
    "attempt_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "retry_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "runtime_seconds": {"type": ["number", "null"], "minimum": 0},
    "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
    "input_point_count": {"type": ["integer", "null"], "minimum": 0},
    "roofer_input_point_count": {"type": ["integer", "null"], "minimum": 0},
    "output_bytes": {"type": "integer", "minimum": 0},
    "failure_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_cell_count", "vertically_scored_cell_count", "reference_vertical_coverage",
        "height_error_signed_mean_m", "height_error_signed_median_m", "height_error_mae_m",
        "RMSZ_m", "RMSXY_m", "surface_distance_rmse_m", "surface_distance_p95_m",
        "normal_angular_error_median_deg", "normal_angular_error_p95_deg",
        "roof_plane_completeness", "roof_plane_correctness", "roof_plane_quality",
        "oversegmentation", "undersegmentation", "null_reasons"
      ],
      "properties": {
        "reference_cell_count": {"type": "integer", "minimum": 0},
        "vertically_scored_cell_count": {"type": "integer", "minimum": 0},
        "reference_vertical_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "height_error_signed_mean_m": {"type": ["number", "null"]},
        "height_error_signed_median_m": {"type": ["number", "null"]},
        "height_error_mae_m": {"type": ["number", "null"], "minimum": 0},
        "RMSZ_m": {"type": ["number", "null"], "minimum": 0},
        "RMSXY_m": {"type": ["number", "null"], "minimum": 0},
        "surface_distance_rmse_m": {"type": ["number", "null"], "minimum": 0},
        "surface_distance_p95_m": {"type": ["number", "null"], "minimum": 0},
        "normal_angular_error_median_deg": {"type": ["number", "null"], "minimum": 0, "maximum": 180},
        "normal_angular_error_p95_deg": {"type": ["number", "null"], "minimum": 0, "maximum": 180},
        "roof_plane_completeness": {"type": "null"},
        "roof_plane_correctness": {"type": "null"},
        "roof_plane_quality": {"type": "null"},
        "oversegmentation": {"type": "null"},
        "undersegmentation": {"type": "null"},
        "null_reasons": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "scientific_verdict": {"type": "null"}
  },
  "metric_formulas": {
    "roof_surface_discretization": "Roofer LoD2.2 RoofSurface exterior rings are deterministically fan-triangulated in stored vertex order; inner rings are rejected rather than silently ignored",
    "reference_vertical_coverage": "n(reference cells with an XY vertical intersection on predicted RoofSurface) / n(reference score cells)",
    "height_error_signed_mean_m": "mean(z_pred_vertical - z_ref)",
    "height_error_signed_median_m": "median(z_pred_vertical - z_ref)",
    "height_error_mae_m": "mean(abs(z_pred_vertical - z_ref))",
    "RMSZ_m": "sqrt(mean((z_pred_vertical - z_ref)^2))",
    "RMSXY_m": "sqrt(mean(dx_nearest_surface^2 + dy_nearest_surface^2)) over reference cells",
    "surface_distance_rmse_m": "sqrt(mean(||p_nearest_roof_surface - p_reference||_2^2))",
    "surface_distance_p95_m": "empirical linear-interpolated 95th percentile of Euclidean nearest-roof-surface distances",
    "normal_angular_error": "acos(clamp(abs(dot(unit(n_pred), unit(n_ref))),0,1)) in degrees",
    "group_balanced_summary": "for each metric, arithmetic mean within each development group followed by an unweighted arithmetic mean across the five groups; no standard error, p-value or confidence interval"
  },
  "deferred_metrics_reason": "MATCHING_RULE_AND_NUMERICAL_G3_G4_THRESHOLDS_NOT_FROZEN",
  "scientific_verdict": null
}
