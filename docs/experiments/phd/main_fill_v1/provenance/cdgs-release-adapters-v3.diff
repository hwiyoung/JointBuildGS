+def jbgs_identity_depth(source, target, mask, depth_weight, prune_ratio=0.001):
+    """JBGS variant (PHD-MAIN-FILL-v1, order 5.1 2; "alignment": "identity"): optimize_depth without its Adam fit. The prior depth is
+    already in metres, so scale 1 and shift 0. The alignment loss is optimize_depth's own loss at those values, with its own lines: the
+    same targets and weights (the caller's), the same 0.1 % prune, the mean of the weighted squared residuals and the negative-depth
+    term (0 here: the prior depth is positive on every target). Called with the same arguments (in the authors' units, divided by s)."""
+    source = torch.from_numpy(source).cuda()
+    target = torch.from_numpy(target).cuda()
+    mask = torch.from_numpy(mask).cuda()
+    depth_weight = torch.from_numpy(depth_weight).cuda()
+
+    with torch.no_grad():   # = optimize_depth's prune
+        target_depth_sorted = target[target>1e-7].sort().values
+        min_prune_threshold = target_depth_sorted[int(target_depth_sorted.numel()*prune_ratio)]
+        max_prune_threshold = target_depth_sorted[int(target_depth_sorted.numel()*(1.0-prune_ratio))]
+
+        mask2 = target > min_prune_threshold
+        mask3 = target < max_prune_threshold
+        mask = torch.logical_and( torch.logical_and(mask, mask2), mask3)
+
+        source_masked = source[mask]
+        target_masked = target[mask]
+        depth_weight_masked = depth_weight[mask]
+
+        scale = torch.ones(1).cuda()
+        shift = torch.zeros(1).cuda()
+        source_hat = scale*source_masked + shift   # = optimize_depth's loss at scale 1, shift 0, without a step
+        loss = torch.mean(((target_masked - source_hat)**2)*depth_weight_masked)
+        loss_hinge1 = loss_hinge2 = 0.0
+        if (source_hat<=0.0).any():
+            loss_hinge1 = 2.0*((source_hat[source_hat<=0.0])**2).mean()
+        loss = loss + loss_hinge1 + loss_hinge2
+        refined_source = (scale*source + shift)
+
+    loss = loss.item()
+    print(f"loss ={loss:10.5f} (scale 1, shift 0, no fit)")
+    _JBGS_LAST.clear()
+    _JBGS_LAST.update(scale=1.0, shift=0.0, loss=float(loss), sfm_points_used=int(mask.sum().item()), adam_iterations=0,
+                      _used_mask=mask.detach().cpu().numpy())
+    torch.cuda.empty_cache()
+    return refined_source.cpu().numpy(), loss
+
 
