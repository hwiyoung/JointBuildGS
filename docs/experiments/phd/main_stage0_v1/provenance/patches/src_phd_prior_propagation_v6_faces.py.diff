--- r11/src/phd/prior_propagation_v6/faces.py
+++ r12/src/phd/prior_propagation_v6/faces.py
@@ -0,0 +1,339 @@
+"""LoD2 faces left out of the prior surface, the outward side of a face and walls shared by two buildings
+(prior_propagation_v4, PHD-STAGE2-R10-TWO-FIXES-THREE-CHECKS-v1; v3 + the party-wall cut). numpy (+ open3d inside
+party_wall_cells, shapely inside party_wall_overlaps / cut_triangles: offline only, the training fork does not import them).
+
+Method document 2026-10-01 (r8 review) 3.1 / 4.3: the bottom face of an LoD2 building (CityGML GroundSurface; a
+ClosureSurface when present) lies inside the walls, no view sees it and it is not reconstructed, so it is not part of the
+prior surface: neither stage 1 (prior depth render, residuals, tolerance, surface numbers, marks, patches) nor stage 2
+(point sampling, planting) takes it. LoD2 without surface types: a face whose normal points down and that lies at the
+lowest height of its building is taken as the bottom face, and the caller reports that this rule was used.
+Order r9 item 3: inner faces other than the bottom face (walls a building shares with its neighbour) stay in the prior;
+they are counted: walls of two buildings that overlap within 0.1 m with opposite normals (party_wall_cells, per cell).
+v4 (method document 2026-10-02, 3.1; order r10 2-2): the part of a wall that overlaps a wall of another building is
+left out of the prior surface as well -- only the overlapping part: the part of a wall that stands above a lower
+neighbour stays. Two wall polygons of different buildings overlap where (party_wall_overlaps)
+  - their outward normals are opposite: cosine <= PARTY_COS (-0.9, the r9 rule),
+  - projected onto their common plane (normal n_c = (n_a - n_b) / |n_a - n_b|, origin = the midpoint of the two
+    centroids, first axis = the horizontal line of the plane) their polygons intersect,
+  - and there the two planes lie within PARTY_DMAX_M (0.1 m) of each other along n_c (an affine function of the
+    position on the common plane: the overlap is clipped to the strip where it holds).
+The overlap (one region per pair, in the common plane) is cut from both walls (cut_triangles): every triangle of a wall
+that meets an overlap is replaced by the triangles of its remaining part (shapely difference in the common plane, ear
+clipping, lifted back along n_c onto the triangle's own plane, winding kept); triangles that do not meet it stay as they
+are.
+
+Normals: the winding normal of a polygon (area-weighted mean of its triangles, the normal the stage-1 store uses).
+CityGML orients polygons outward; outward_side_outside() checks this for walls against the building's footprint."""
+import numpy as np
+
+EXCLUDED_TYPES = ("GroundSurface", "ClosureSurface")
+DOWN_NZ = -0.5          # 'the normal points down': n_z <= -0.5 (the roof/wall split |n_z| = 0.5 of conversion.ROOF_NZ)
+LOWEST_TOL_M = 0.1      # 'at the lowest height of the building': the face's highest vertex within 0.1 m of the lowest vertex
+PARTY_DMAX_M = 0.1      # order r9: overlap within 0.1 m
+PARTY_COS = -0.9        # 'opposite normals': cosine <= -0.9 (within about 25 degrees of anti-parallel)
+
+
+def polygon_table(V, F, tri_poly):
+    """per polygon id (sorted unique of tri_poly): winding unit normal, area, area-weighted centroid, lowest and highest
+    vertex height. Returns a dict of arrays aligned with 'ids'."""
+    V = np.asarray(V, np.float64); F = np.asarray(F, np.int64); tp = np.asarray(tri_poly, np.int64)
+    cr = np.cross(V[F[:, 1]] - V[F[:, 0]], V[F[:, 2]] - V[F[:, 0]])
+    a = 0.5 * np.linalg.norm(cr, axis=1)
+    ids, inv = np.unique(tp, return_inverse=True)
+    S = np.zeros((len(ids), 3)); np.add.at(S, inv, cr)
+    nrm = S / np.maximum(np.linalg.norm(S, axis=1, keepdims=True), 1e-300)
+    area = np.bincount(inv, weights=a, minlength=len(ids))
+    C = np.zeros((len(ids), 3)); np.add.at(C, inv, V[F].mean(1) * a[:, None])
+    C /= np.maximum(area, 1e-300)[:, None]
+    zt = V[F][:, :, 2]
+    zmin = np.full(len(ids), np.inf); np.minimum.at(zmin, inv, zt.min(1))
+    zmax = np.full(len(ids), -np.inf); np.maximum.at(zmax, inv, zt.max(1))
+    return dict(ids=ids, normal=nrm, area=area, centroid=C, zmin=zmin, zmax=zmax)
+
+
+def excluded_by_type(types):
+    """bool per face: its CityGML type is a bottom face (GroundSurface) or a closure face (ClosureSurface)."""
+    return np.isin(np.asarray(types).astype(str), EXCLUDED_TYPES)
+
+
+def bottom_faces_untyped(normal_z, z_max_face, z_min_building):
+    """bool per face of LoD2 without surface types: the (outward) normal points down and the face lies at the lowest
+    height of its building (its highest vertex within LOWEST_TOL_M of the building's lowest vertex)."""
+    return (np.asarray(normal_z) <= DOWN_NZ) & (np.asarray(z_max_face) <= np.asarray(z_min_building) + LOWEST_TOL_M)
+
+
+def _in_triangles_xy(P, T):
+    """bool [N]: P [N, 2] inside (or on) any triangle of T [M, 3, 2]."""
+    P = np.asarray(P, np.float64)[:, None, :]; T = np.asarray(T, np.float64)[None]
+    if T.shape[1] == 0:
+        return np.zeros(P.shape[0], bool)
+
+    def cross(a, b, p):
+        return (b[..., 0] - a[..., 0]) * (p[..., 1] - a[..., 1]) - (b[..., 1] - a[..., 1]) * (p[..., 0] - a[..., 0])
+    d1 = cross(T[..., 0, :], T[..., 1, :], P); d2 = cross(T[..., 1, :], T[..., 2, :], P); d3 = cross(T[..., 2, :], T[..., 0, :], P)
+    neg = (d1 < 0) | (d2 < 0) | (d3 < 0); pos = (d1 > 0) | (d2 > 0) | (d3 > 0)
+    return (~(neg & pos)).any(1)
+
+
+def outward_side_outside(centroid, normal, footprint_tris_xy, step=0.05):
+    """For wall faces of one building: (outside_plus [N], outside_minus [N]) whether the centroid moved `step` metres along
+    +/- the horizontal part of the normal falls outside every footprint triangle (XY). outside_plus & ~outside_minus:
+    the normal points out of the building; the reverse: it points in; both equal: undetermined (e.g. a wall between two
+    roof levels above the footprint)."""
+    c = np.asarray(centroid, np.float64)[:, :2]; n = np.asarray(normal, np.float64)[:, :2]
+    nh = n / np.maximum(np.linalg.norm(n, axis=1, keepdims=True), 1e-12)
+    plus = ~_in_triangles_xy(c + step * nh, footprint_tris_xy)
+    minus = ~_in_triangles_xy(c - step * nh, footprint_tris_xy)
+    return plus, minus
+
+
+def party_wall_cells(cell_xyz, cell_building, cell_normal, wall_V, wall_F, wall_tri_building, wall_tri_normal,
+                     dmax=PARTY_DMAX_M, cos_opposite=PARTY_COS):
+    """Cells (patch centres) of walls that a building shares with another one: the centre lies within dmax of a wall
+    triangle of another building whose (outward) normal is opposite (cosine <= cos_opposite).
+    Returns (shared [C] bool, distance [C], partner triangle [C] (-1 none))."""
+    import open3d as o3d
+    cell_xyz = np.asarray(cell_xyz, np.float64); cell_building = np.asarray(cell_building).astype(str)
+    wall_tri_building = np.asarray(wall_tri_building).astype(str)
+    shared = np.zeros(len(cell_xyz), bool); dist = np.full(len(cell_xyz), np.inf); partner = np.full(len(cell_xyz), -1, np.int64)
+    for b in np.unique(cell_building):
+        sc_ = cell_building == b
+        other = np.nonzero(wall_tri_building != b)[0]
+        if len(other) == 0 or not sc_.any():
+            continue
+        scene = o3d.t.geometry.RaycastingScene()
+        scene.add_triangles(o3d.core.Tensor(np.asarray(wall_V, np.float32)), o3d.core.Tensor(np.asarray(wall_F, np.uint32)[other]))
+        ans = scene.compute_closest_points(o3d.core.Tensor(cell_xyz[sc_].astype(np.float32)))
+        d = np.linalg.norm(ans["points"].numpy().astype(np.float64) - cell_xyz[sc_], axis=1)
+        tri = other[ans["primitive_ids"].numpy().astype(np.int64)]
+        opp = (np.asarray(wall_tri_normal, np.float64)[tri] * np.asarray(cell_normal, np.float64)[sc_]).sum(1) <= cos_opposite
+        shared[sc_] = (d <= dmax) & opp
+        dist[sc_] = d
+        partner[sc_] = np.where((d <= dmax) & opp, tri, -1)
+    return shared, dist, partner
+
+
+# ------------------------------------------------------------------------------------- v4: the party-wall cut
+PARTY_MIN_AREA_M2 = 1e-6    # overlaps / remaining pieces smaller than this (touching edges, rounding slivers) are ignored
+
+
+def _unit(v):
+    v = np.asarray(v, np.float64)
+    return v / max(np.linalg.norm(v), 1e-300)
+
+
+def common_frame(n_a, n_b, c_a, c_b):
+    """(o, e1, e2, n_c) of the common plane of two facing walls: n_c = (n_a - n_b) / |n_a - n_b| (outward normals,
+    opposite), o = the midpoint of the two centroids, e1 = the horizontal line of the plane (z x n_c; x on a level
+    plane), e2 = n_c x e1."""
+    n_c = _unit(np.asarray(n_a, np.float64) - np.asarray(n_b, np.float64))
+    o = 0.5 * (np.asarray(c_a, np.float64) + np.asarray(c_b, np.float64))
+    e1 = np.cross([0.0, 0.0, 1.0], n_c)
+    e1 = _unit(e1) if np.linalg.norm(e1) > 1e-6 else np.array([1.0, 0.0, 0.0])
+    e2 = _unit(np.cross(n_c, e1))
+    return o, e1, e2, n_c
+
+
+def to_plane(X, frame):
+    """2-D coordinates (u, v) on the common plane of points X [..., 3] (orthogonal projection along n_c)."""
+    o, e1, e2, _ = frame
+    d = np.asarray(X, np.float64) - o
+    return np.stack([d @ e1, d @ e2], -1)
+
+
+def lift(uv, frame, p, n):
+    """points (u, v) [K, 2] of the common plane moved along n_c onto the plane through p with normal n."""
+    o, e1, e2, n_c = frame
+    uv = np.asarray(uv, np.float64)
+    X0 = o + uv[:, :1] * e1 + uv[:, 1:2] * e2
+    den = float(np.dot(n, n_c))
+    h = ((np.asarray(p, np.float64) - X0) @ np.asarray(n, np.float64)) / (den if abs(den) > 1e-12 else 1e-12)
+    return X0 + h[:, None] * n_c
+
+
+def _gap_coeffs(frame, p_a, n_a, p_b, n_b):
+    """gap(u, v) = h_a - h_b = c0 + c1 u + c2 v: offset along n_c between the two planes above (u, v)."""
+    o, e1, e2, n_c = frame
+
+    def coeffs(p, n):
+        n = np.asarray(n, np.float64); den = float(np.dot(n, n_c))
+        den = den if abs(den) > 1e-12 else 1e-12
+        return np.array([np.dot(n, np.asarray(p, np.float64) - o), -np.dot(n, e1), -np.dot(n, e2)]) / den
+    return coeffs(p_a, n_a) - coeffs(p_b, n_b)
+
+
+def _halfplane_clip(poly_xy, a, b, c):
+    """convex polygon [K, 2] clipped to a + b u + c v <= 0 (Sutherland-Hodgman)."""
+    out = []
+    P = list(poly_xy)
+    for i in range(len(P)):
+        cur, nxt = np.asarray(P[i]), np.asarray(P[(i + 1) % len(P)])
+        fc, fn = a + b * cur[0] + c * cur[1], a + b * nxt[0] + c * nxt[1]
+        if fc <= 0:
+            out.append(cur)
+        if (fc <= 0) != (fn <= 0):
+            t = fc / (fc - fn)
+            out.append(cur + t * (nxt - cur))
+    return np.array(out) if out else np.zeros((0, 2))
+
+
+def gap_strip(coef, bounds, dmax):
+    """shapely polygon of the points of the box bounds = (u0, v0, u1, v1) where |gap(u, v)| <= dmax."""
+    from shapely.geometry import Polygon
+    u0, v0, u1, v1 = bounds
+    box_ = np.array([[u0, v0], [u1, v0], [u1, v1], [u0, v1]], np.float64)
+    c0, c1, c2 = coef
+    q = _halfplane_clip(box_, c0 - dmax, c1, c2)            # gap <= dmax
+    if len(q) >= 3:
+        q = _halfplane_clip(q, -c0 - dmax, -c1, -c2)         # -gap <= dmax
+    return Polygon(q) if len(q) >= 3 else Polygon()
+
+
+def polygon_2d(tris_2d):
+    """union of 2-D triangles [k, 3, 2] (one LoD2 polygon) as a shapely geometry."""
+    from shapely.geometry import Polygon
+    from shapely.ops import unary_union
+    return unary_union([Polygon(t) for t in tris_2d if abs(_area2(t)) > 1e-12]).buffer(0)
+
+
+def _area2(t):
+    t = np.asarray(t, np.float64)
+    return 0.5 * ((t[1, 0] - t[0, 0]) * (t[2, 1] - t[0, 1]) - (t[2, 0] - t[0, 0]) * (t[1, 1] - t[0, 1]))
+
+
+def party_wall_overlaps(polys, dmax=PARTY_DMAX_M, cos_opposite=PARTY_COS, min_area=PARTY_MIN_AREA_M2):
+    """polys: list of dict(id, building, normal (outward unit [3]), tris [k, 3, 3]) of wall polygons. Pairs of different
+    buildings with opposite outward normals whose projections on the common plane overlap where the planes lie within
+    dmax. Returns a list of dict(a, b (ids), frame (o, e1, e2, n_c), region (shapely, common-plane coordinates), area,
+    gap_max (|gap| over the region's vertices), cos, overlap_before_gap (area of the plain intersection))."""
+    from shapely.geometry import Polygon  # noqa: F401
+    P = [dict(p, tris=np.asarray(p["tris"], np.float64), normal=_unit(p["normal"])) for p in polys]
+    lo = np.array([p["tris"].reshape(-1, 3).min(0) for p in P]); hi = np.array([p["tris"].reshape(-1, 3).max(0) for p in P])
+    out = []
+    for i in range(len(P)):
+        for j in range(i + 1, len(P)):
+            a, b = P[i], P[j]
+            if str(a["building"]) == str(b["building"]):
+                continue
+            cs = float(np.dot(a["normal"], b["normal"]))
+            if cs > cos_opposite:
+                continue
+            if np.any(lo[i] > hi[j] + dmax) or np.any(lo[j] > hi[i] + dmax):
+                continue
+            ca = a["tris"].reshape(-1, 3).mean(0); cb = b["tris"].reshape(-1, 3).mean(0)
+            fr = common_frame(a["normal"], b["normal"], ca, cb)
+            pa = polygon_2d(to_plane(a["tris"], fr)); pb = polygon_2d(to_plane(b["tris"], fr))
+            inter = pa.intersection(pb)
+            if inter.area < min_area:
+                continue
+            u0, v0, u1, v1 = inter.bounds
+            coef = _gap_coeffs(fr, a["tris"][0, 0], a["normal"], b["tris"][0, 0], b["normal"])
+            reg = inter.intersection(gap_strip(coef, (u0 - 1.0, v0 - 1.0, u1 + 1.0, v1 + 1.0), dmax))
+            if reg.area < min_area:
+                continue
+            xy = np.concatenate([np.asarray(g.exterior.coords) for g in getattr(reg, "geoms", [reg]) if g.geom_type == "Polygon"])
+            gap = np.abs(coef[0] + coef[1] * xy[:, 0] + coef[2] * xy[:, 1])
+            out.append(dict(a=a["id"], b=b["id"], frame=fr, region=reg, area=float(reg.area), gap_max=float(gap.max()),
+                            gap_min=float(gap.min()), cos=cs, overlap_before_gap=float(inter.area)))
+    return out
+
+
+def ear_clip(xy):
+    """triangles (index triples) of a simple polygon [K, 2] without holes (ear clipping; collinear vertices allowed)."""
+    xy = np.asarray(xy, np.float64)
+    if len(xy) > 1 and np.allclose(xy[0], xy[-1]):
+        xy = xy[:-1]
+    n = len(xy)
+    if n < 3:
+        return []
+    area = 0.5 * np.sum(xy[:, 0] * np.roll(xy[:, 1], -1) - np.roll(xy[:, 0], -1) * xy[:, 1])
+    idx = list(range(n)) if area > 0 else list(range(n))[::-1]
+
+    def cross(o_, a_, b_):
+        return (a_[0] - o_[0]) * (b_[1] - o_[1]) - (a_[1] - o_[1]) * (b_[0] - o_[0])
+
+    def inside(p, a_, b_, c_):
+        return cross(a_, b_, p) >= -1e-15 and cross(b_, c_, p) >= -1e-15 and cross(c_, a_, p) >= -1e-15
+    tris, guard = [], 0
+    while len(idx) > 3 and guard < 10 * n * n:
+        guard += 1
+        m = len(idx)
+        for k in range(m):
+            i0, i1, i2 = idx[(k - 1) % m], idx[k], idx[(k + 1) % m]
+            a_, b_, c_ = xy[i0], xy[i1], xy[i2]
+            cr = cross(a_, b_, c_)
+            if cr <= 1e-15:                       # reflex or collinear: not an ear (collinear removed below)
+                if abs(cr) <= 1e-15 and np.dot(b_ - a_, c_ - b_) > 0:
+                    idx.pop(k); break             # a straight vertex: drop it
+                continue
+            if any(inside(xy[j], a_, b_, c_) for j in idx if j not in (i0, i1, i2)):
+                continue
+            tris.append((i0, i1, i2)); idx.pop(k); break
+        else:
+            break                                 # no ear found (degenerate input): stop
+    if len(idx) == 3:
+        a_, b_, c_ = (xy[i] for i in idx)
+        if cross(a_, b_, c_) > 1e-15:
+            tris.append(tuple(idx))
+    return tris
+
+
+def _no_holes(poly):
+    """split a shapely polygon by vertical lines through its holes until no piece has a hole."""
+    from shapely.geometry import LineString
+    from shapely.ops import split
+    todo, done = [poly], []
+    while todo:
+        g = todo.pop()
+        if g.is_empty or g.area < 1e-12:
+            continue
+        if len(g.interiors) == 0:
+            done.append(g); continue
+        cx = g.interiors[0].centroid.x
+        y0, y1 = g.bounds[1] - 1.0, g.bounds[3] + 1.0
+        parts = split(g, LineString([(cx, y0), (cx, y1)]))
+        for q in parts.geoms:
+            if q.geom_type == "Polygon":
+                todo.append(q)
+    return done
+
+
+def cut_triangles(tris, cuts, min_area=PARTY_MIN_AREA_M2):
+    """tris [k, 3, 3] (one wall polygon); cuts = list of (frame, region) (regions in their frame's coordinates).
+    Returns (new [m, 3, 3], source [m] (index of the input triangle each output triangle comes from), touched [k] bool,
+    info). Untouched triangles are passed through unchanged (same vertices, same order)."""
+    from shapely.geometry import Polygon
+    tris = np.asarray(tris, np.float64)
+    cur = [(t, i) for i, t in enumerate(tris)]
+    touched = np.zeros(len(tris), bool)
+    info = dict(sliver_area_dropped_m2=0.0, pieces_with_holes=0)
+    for frame, region in cuts:
+        nxt = []
+        for t, src in cur:
+            t2 = to_plane(t, frame)
+            tp = Polygon(t2)
+            if not tp.is_valid or tp.area < 1e-14 or tp.intersection(region).area < min_area:
+                nxt.append((t, src)); continue
+            touched[src] = True
+            nrm = np.cross(t[1] - t[0], t[2] - t[0]); nrm = nrm / max(np.linalg.norm(nrm), 1e-300)
+            rem = tp.difference(region)
+            for g in getattr(rem, "geoms", [rem]):
+                if g.geom_type != "Polygon" or g.is_empty:
+                    continue
+                if g.area < min_area:
+                    info["sliver_area_dropped_m2"] += float(g.area); continue
+                if len(g.interiors):
+                    info["pieces_with_holes"] += 1
+                for h in _no_holes(g):
+                    xy = np.asarray(h.exterior.coords)[:-1]
+                    for (i0, i1, i2) in ear_clip(xy):
+                        T = lift(xy[[i0, i1, i2]], frame, t[0], nrm)
+                        if np.dot(np.cross(T[1] - T[0], T[2] - T[0]), nrm) < 0:
+                            T = T[[0, 2, 1]]
+                        if 0.5 * np.linalg.norm(np.cross(T[1] - T[0], T[2] - T[0])) > 1e-12:
+                            nxt.append((T, src))
+        cur = nxt
+    new = np.array([t for t, _ in cur]) if cur else np.zeros((0, 3, 3))
+    source = np.array([s for _, s in cur], np.int64)
+    return new, source, touched, info
+
