+# ---- JBGS (PHD-MAIN-BASELINES-v1): the prior-depth mask in the depth loss's normalisation (order 5.5 2) and logging only (order 4.2,
+# 4.10: memory, the iteration's image and Gaussian count at a stop, a NaN loss stops). Nothing else of the training changes.
+import json as _jbgs_json
+import math as _jbgs_math
+import time as _jbgs_time
+_JBGS = dict(iteration=None, image=None, gaussians=None, model_path=None, t0=_jbgs_time.time(), skipped_flat=0)
