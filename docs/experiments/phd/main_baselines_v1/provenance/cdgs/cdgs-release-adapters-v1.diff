+def jbgs_calculate_confidence_hit(depthmap, image, valid, window_size=5):
+    """JBGS (order 5.5 2): calculate_confidence with the pixels without a prior hit left out. The same three features and
+    weights; every statistic (the Laplacian's maximum, each feature's min-max, the final min-max) is taken over the hit pixels;
+    the Sobel input takes at a no-hit pixel the nearest hit pixel's depth (the end of the prior's coverage is extended as the
+    image border is, so it makes no depth step); the confidence is 0 at no-hit pixels. With every pixel hit it equals
+    calculate_confidence."""
+    from scipy.ndimage import distance_transform_edt
+    if isinstance(image, Image.Image):
+        image = np.array(image)
+    gray_image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
+    edges = cv2.Canny(gray_image, 100, 200)
+    edge_confidence = 1 - edges / 255.0
+    laplacian = cv2.Laplacian(gray_image, cv2.CV_64F)
+    texture_confidence = 1 - np.abs(laplacian) / np.max(np.abs(laplacian)[valid])
+    if valid.all():
+        filled = depthmap
+    else:
+        iy, ix = distance_transform_edt(~valid, return_distances=False, return_indices=True)
+        filled = depthmap[iy, ix]
+    grad_x = cv2.Sobel(filled, cv2.CV_64F, 1, 0, ksize=5)
+    grad_y = cv2.Sobel(filled, cv2.CV_64F, 0, 1, ksize=5)
+    grad_magnitude = np.sqrt(grad_x ** 2 + grad_y ** 2)
+    gradient_confidence = 1 / (grad_magnitude + 1e-6)
+
+    def _mm(x):
+        lo, hi = x[valid].min(), x[valid].max()
+        return (x - lo) / (hi - lo) if hi > lo else np.ones_like(x)
+    edge_confidence = _mm(edge_confidence)
+    texture_confidence = _mm(texture_confidence)
+    gradient_confidence = _mm(gradient_confidence)
+    final_confidence_map = 0.2 * edge_confidence + 0.5 * texture_confidence + 0.3 * gradient_confidence
+    final_confidence_map = _mm(final_confidence_map)
+    final_confidence_map[~valid] = 0.0
+    return final_confidence_map
+
