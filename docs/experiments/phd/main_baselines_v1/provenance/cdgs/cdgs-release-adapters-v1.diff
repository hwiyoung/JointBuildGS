+def jbgs_normalize_depth_masked(depth, mask):
+    """normalize_depth with its min and max over the prior-hit pixels (mask) only; 0 outside the mask."""
+    mask = mask.to(depth.device)
+    lo, hi = depth[mask].min(), depth[mask].max()
+    return (depth - lo) / (hi - lo) * mask
+
+
+def jbgs_flat(gt_depth, depth):
+    """True when the min-max normalisation over the prior-hit pixels is undefined for this view and iteration (no hit pixel, or
+    the prior depth or the render constant over them): the view then has no depth loss at this iteration (counted, logged)."""
+    mask = (gt_depth > 0).to(depth.device)
+    flat = (not bool(mask.any())) or bool(gt_depth.to(depth.device)[mask].max() <= gt_depth.to(depth.device)[mask].min()) or bool(depth[mask].max() <= depth[mask].min())
+    if flat:
+        _JBGS["skipped_flat"] += 1
+        jbgs_log("jbgs_depth_skipped.jsonl", dict(iteration=_JBGS["iteration"], image=_JBGS["image"]))
+    return flat
+
+
+def jbgs_memory():
+    return dict(allocated_gb=round(torch.cuda.memory_allocated() / 1024 ** 3, 3), reserved_gb=round(torch.cuda.memory_reserved() / 1024 ** 3, 3),
+                max_allocated_gb=round(torch.cuda.max_memory_allocated() / 1024 ** 3, 3), max_reserved_gb=round(torch.cuda.max_memory_reserved() / 1024 ** 3, 3))
+
+
