FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG DN_SPLATTER_COMMIT=97588b4290128ce7ba6fdbfaac3020b42b17de4c

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git libegl1 libgl1 libglib2.0-0 libgomp1 \
        libxext6 libxrender1 ninja-build python3-dev python3-pip && \
    rm -rf /var/lib/apt/lists/*

# The experiment host runs containers as uid/gid 1000. Triton 2.2 creates a
# dump manager under Path.home() even when TRITON_CACHE_DIR is set, so provide
# a real passwd entry and writable home for that unprivileged runtime user.
RUN groupadd --gid 1000 jbgs-runtime && \
    useradd --uid 1000 --gid 1000 --create-home jbgs-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python3 -m pip install --no-cache-dir \
        pip==24.0 setuptools==69.5.1 wheel==0.43.0 numpy==1.26.4 && \
    python3 -m pip install --no-cache-dir \
        torch==2.2.2+cu118 torchvision==0.17.2+cu118 \
        --index-url https://download.pytorch.org/whl/cu118
ENV PATH=/opt/pixi/bin:${PATH}

RUN git clone https://github.com/maturk/dn-splatter.git /opt/dn-splatter && \
    cd /opt/dn-splatter && \
    git checkout --detach "${DN_SPLATTER_COMMIT}" && \
    test "$(git rev-parse HEAD)" = "${DN_SPLATTER_COMMIT}"

WORKDIR /opt/dn-splatter
RUN python3 -m pip install --no-cache-dir \
        numpy==1.26.4 'rerun-sdk>=0.15.1,<0.16' . && \
    python3 -m pip check && \
    python3 -c "import cv2, dn_splatter, gsplat, nerfstudio, torch" && \
    test -z "$(git status --porcelain)"
RUN mkdir -p /opt/torch-cache && \
    TORCH_HOME=/opt/torch-cache python3 -c \
        "from torchvision.models import AlexNet_Weights, alexnet; alexnet(weights=AlexNet_Weights.DEFAULT)" && \
    chmod -R a+rX /opt/torch-cache
ENV TORCH_HOME=/opt/torch-cache

ENTRYPOINT []
