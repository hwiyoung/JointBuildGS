FROM pdal/pdal@sha256:dabc2c1b5de34fb2eff749ddba066cc66a7aa9448eac6e93743c32c7e4aa5051

ARG VAL3DITY_VERSION=2.6.0
ARG CITYGML_TOOLS_VERSION=2.5.0
ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.base.name="pdal/pdal:latest"
LABEL org.opencontainers.image.base.digest="sha256:dabc2c1b5de34fb2eff749ddba066cc66a7aa9448eac6e93743c32c7e4aa5051"
LABEL org.opencontainers.image.description="P0 tools runtime: PDAL, GDAL, laspy, val3dity, citygml-tools"

SHELL ["/bin/bash", "-lc"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      git \
      libboost-filesystem-dev \
      libboost-system-dev \
      libcgal-dev \
      libeigen3-dev \
      libgeos-dev \
      openjdk-17-jre-headless \
      unzip \
    && rm -rf /var/lib/apt/lists/*

RUN /opt/conda/bin/pip install --no-cache-dir 'laspy[lazrs]==2.6.1'

RUN git clone --depth 1 --branch "${VAL3DITY_VERSION}" https://github.com/tudelft3d/val3dity.git /tmp/val3dity \
    && cmake -S /tmp/val3dity -B /tmp/val3dity/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/val3dity/build --parallel "$(nproc)" \
    && cmake --install /tmp/val3dity/build \
    && rm -rf /tmp/val3dity

RUN curl -fsSL "https://github.com/citygml4j/citygml-tools/releases/download/v${CITYGML_TOOLS_VERSION}/citygml-tools-${CITYGML_TOOLS_VERSION}.zip" \
      -o /tmp/citygml-tools.zip \
    && unzip -q /tmp/citygml-tools.zip -d /opt \
    && mv "/opt/citygml-tools-${CITYGML_TOOLS_VERSION}" /opt/citygml-tools \
    && ln -s /opt/citygml-tools/citygml-tools /usr/local/bin/citygml-tools \
    && rm -f /tmp/citygml-tools.zip
