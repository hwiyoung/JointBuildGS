    "global_robust_rank": "for each covariate, average midrank among the locked 114 then scale as (midrank-1)/(n-1); ties share a rank",
    "cell_center": "coordinate-wise median of the five global robust ranks among candidates in that cell",
    "distance": "Euclidean L2 distance from candidate global-rank vector to its cell median vector",
    "winner": "minimum distance, then lexicographically smallest building_id",
    "missing_policy": "fail before selection; no imputation",
    "allowed_selector_fields": [
