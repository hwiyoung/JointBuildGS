# ACMP + ACMMP (GhiXu) — plane-prior PatchMatch MVS, off-the-shelf, COLMAP input.
# P2 textureless-signal diagnosis (C). RTX 3090 = sm_86.
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake build-essential libopencv-dev python3 python3-numpy ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN git clone --depth 1 https://github.com/GhiXu/ACMP.git && \
    git clone --depth 1 https://github.com/GhiXu/ACMMP.git
# Force sm_86 (Ampere) into both CMakeLists (repos hardcode older archs) + relax CMake CUDA arch policy.
RUN for d in ACMP ACMMP; do \
      sed -i 's/-gencode arch=compute_[0-9]*,code=sm_[0-9]*/-gencode arch=compute_86,code=sm_86/g' $d/CMakeLists.txt || true; \
      grep -q compute_86 $d/CMakeLists.txt || sed -i '/find_package(CUDA/a set(CUDA_NVCC_FLAGS ${CUDA_NVCC_FLAGS};-gencode arch=compute_86,code=sm_86)' $d/CMakeLists.txt; \
    done
RUN cd ACMP   && mkdir -p build && cd build && cmake .. && make -j"$(nproc)"
# ACMMP (multi-scale successor) is best-effort: its cmake needs extras ACMP doesn't; ACMP alone
# covers the plane-prior MVS test. Don't fail the image if ACMMP doesn't configure/compile.
RUN cd ACMMP && mkdir -p build && cd build && (cmake .. && make -j"$(nproc)") \
      && echo "ACMMP_BUILD=ok" || echo "ACMMP_BUILD=skipped (cmake/make failed; ACMP is sufficient)"
# python cv2 for colmap2mvsnet_acm.py (separate late layer -> keeps the ACMP build cache)
RUN apt-get update && apt-get install -y --no-install-recommends python3-opencv \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
