# Build context is the pinned external Depth-Anything-3 source checkout.
# Weights remain outside the image. Existing images are never modified or pruned.
FROM jointbuildgs:dev
LABEL org.jointbuildgs.task="PHD-GEOGS-P1P2P3-v1" \
      org.jointbuildgs.da3.commit="3d835ec1a5802d64a8b8b15f817a1ab54809bfe4"
ENV PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
# Depth-only API dependencies; optional UI/training/GS dependencies are not used.
# Retain the base torch 2.4.1+cu121, torchvision 0.19.1+cu121, numpy 1.26.4.
RUN python -m pip install --no-cache-dir \
    huggingface-hub==0.28.1 safetensors==0.5.3 omegaconf==2.3.0 \
    evo==1.30.0 pycolmap==3.11.1 moviepy==1.0.3 \
    hatchling==1.27.0 hatch-vcs==0.5.0
COPY src /opt/Depth-Anything-3/src
COPY pyproject.toml README.md /opt/Depth-Anything-3/
RUN python -m pip install --no-deps --no-build-isolation /opt/Depth-Anything-3 && \
    python -c 'import torch, torchvision, numpy; from depth_anything_3.api import DepthAnything3; assert torch.__version__ == "2.4.1+cu121"; assert torchvision.__version__ == "0.19.1+cu121"; assert numpy.__version__ == "1.26.4"; print("DA3_API_IMPORT_PASS")'
WORKDIR /work
ENTRYPOINT ["python"]
