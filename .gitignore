# Phase 2 Step 2-2: 4-condition training + Stage 3 artifacts
# Keep: REPORT.md, figures/*.png, */eval/eval_summary.json, */stage3/stage3_summary.json,
#       stage2_primitive_metrics.json, _gt_*/summary.json
# Drop: per-building CityJSON/val3dity (regenerable from ckpts), logs, 2.5D dead branches,
#       preview images, PolyFit CLI binary.
results/phase2_ablation_citygml/*/ckpt/
results/phase2_ablation_citygml/*/tb/
results/phase2_ablation_citygml/*/renders/
results/phase2_ablation_citygml/*/eval_preview.png
results/phase2_ablation_citygml/*/stage3/primitives.npz
results/phase2_ablation_citygml/*/stage3/building_*/
results/phase2_ablation_citygml/*/stage3_2_5d/
results/phase2_ablation_citygml/*/eval_2_5d/
results/phase2_ablation_citygml/_gt_*/building_*/
results/phase2_ablation_citygml/_gt_stage3_test_2_5d/
results/phase2_ablation_citygml/_gt_stage3_test_2_5d_v3/
results/phase2_ablation_citygml/_logs/

# PolyFit CLI binary (regenerate via g++ + CGAL 5.6 headers + SCIP)
src/stage3/polyfit_cli

